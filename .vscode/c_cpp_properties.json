{
  "configurations": [
    {
      "name": "Arduino AVR (Zumo32U4 / ATmega32U4)",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.7/cores/arduino",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.7/variants/leonardo",
        "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "${env:USERPROFILE}/Documents/Arduino/libraries/**"
      ],
      "defines": [
        "ARDUINO=10819",
        "ARDUINO_ARCH_AVR",
        "ARDUINO_AVR_LEONARDO",
        "__AVR_ATmega32U4__",
        "F_CPU=16000000L",
        "USBCON"
      ],
      "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++.exe",
      "compilerArgs": [
        "-mmcu=atmega32u4"
      ],
      "cStandard": "gnu11",
      "cppStandard": "gnu++11",
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
